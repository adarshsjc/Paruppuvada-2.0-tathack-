# App Configuration
# USE_MOCK_LLM=True uses MockLLM for offline testing.
USE_MOCK_LLM=True

# LLM Provider selection (used when USE_MOCK_LLM=False):
#   "ollama"     -> fully local models via Ollama (no API key; default qwen2.5:7b)
#   "openrouter" -> cloud free/open models via OpenRouter (requires API key)
LLM_PROVIDER=ollama

# --- Ollama Local LLM (used when LLM_PROVIDER=ollama) ---
# Requires a running Ollama server (https://ollama.com) with the model pulled:
#   ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Comma-separated model list, one per parallel solution agent (up to 3).
OLLAMA_AGENT_MODELS=qwen2.5:7b,qwen2.5:7b,qwen2.5:7b
OLLAMA_NUM_CTX=8192

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# Set USE_MOCK_LLM=False, LLM_PROVIDER=openrouter and configure your
# OpenRouter key to use three simultaneous free-model solution agents and a
# free-model judge.
# OPENROUTER_API_KEY=PASTE_YOUR_API_KEY_HERE
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_AGENT_MODELS=openrouter/free,openrouter/free,openrouter/free

# Automatically search the public web when no matching memory is found.
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=5

# --- Workflow speed tuning ---
# Number of parallel solution agents (1 = fastest, 3 = most thorough).
# On hardware where Ollama serializes concurrent requests (limited VRAM),
# parallel agents do NOT speed things up — keep AGENT_COUNT=1.
AGENT_COUNT=1
# ENSEMBLE_JUDGE=True adds one extra "judge" inference call to pick the best
# candidate. Set ENSEMBLE_JUDGE=False to use the first successful answer
# (fastest; suitable for a single agent).
ENSEMBLE_JUDGE=False

