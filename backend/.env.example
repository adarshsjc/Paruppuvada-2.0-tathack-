# App Configuration
USE_MOCK_LLM=True

# Set USE_MOCK_LLM=False and configure your OpenRouter key to use three
# simultaneous free-model solution agents and a free-model judge.
OPENROUTER_API_KEY=PASTE_YOUR_API_KEY_HERE
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODELS=openrouter/free,openrouter/free,openrouter/free

# Automatically search the public web when no matching memory is found.
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=5
