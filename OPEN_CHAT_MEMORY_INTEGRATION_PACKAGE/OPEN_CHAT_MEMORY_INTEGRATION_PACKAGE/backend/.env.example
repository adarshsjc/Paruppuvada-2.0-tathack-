# =====================================================================
# Open Chat — backend configuration
# Copy this file to `.env` and edit. Everything below is optional;
# the defaults run the full system in deterministic Mock mode.
# =====================================================================

# ---------------------------------------------------------------------
# THE MODEL SLOT  (the only line you normally need to change)
#
# 1. Install your model:      ollama pull qwen2.5:3b
# 2. Point this file at it:   OLLAMA_MODEL=qwen2.5:3b
# 3. Turn off mock mode:      USE_MOCK_LLM=False
# 4. Verify:                  python check_ollama.py
#
# The engine is model-agnostic: any tag present in `ollama list` works.
# Note: `qwen2.5:9b` does NOT exist in the Ollama registry (verified 404;
# Qwen2.5 ships 0.5b/1.5b/3b/7b/14b/32b/72b). For a ~9B model use the
# 7B (`qwen2.5:7b`) or pull a 9B from another series you prefer.
# ---------------------------------------------------------------------
USE_MOCK_LLM=True
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional: semantic embeddings via Ollama ('none' = deterministic keyword
# retrieval, honestly labeled as such in the UI and retrieval payloads)
EMBEDDING_PROVIDER=none
OLLAMA_EMBED_MODEL=nomic-embed-text

# Alternative providers (kept from the original project; unused unless
# LLM_PROVIDER is switched)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Memory graph / execution
MEMORY_DB_PATH=memory.db
WORKSPACE_DIR=workspace
MAX_RETRIES_PER_STEP=2
RETRY_BACKOFF_SECONDS=0.2
MAX_WORKFLOW_STEPS=24
CONTEXT_BUDGET_CHARS=6000

# Optional MiroFish simulation adapter (OFF by default; does not affect
# normal task execution)
MIROFISH_ENABLED=false
MIROFISH_BASE_URL=http://127.0.0.1:5000
